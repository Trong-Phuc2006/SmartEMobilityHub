# Public local defaults. Copy to backend/.env; never commit the real .env.
NODE_ENV=development
HOST=localhost
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
# Resolved relative to backend/, regardless of the PowerShell working directory.
# P1 only permits the approved demo path. Never point this at the team database.
DATABASE_PATH=../database/smart_mobility.demo.db
# REQUIRED for Auth startup. Generate 32 random bytes as 64 hex in backend environment.
# No usable default. See README PowerShell setup; never put this in frontend env files.
JWT_SECRET=
# localhost HTTP=false; set true for HTTPS/TLS termination. No Domain attribute.
COOKIE_SECURE=false
